{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./out/types/node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "src/renderer/src/office/**/*.ts", "src/renderer/src/command/**/*.ts", "test/**/*.ts"]
}
