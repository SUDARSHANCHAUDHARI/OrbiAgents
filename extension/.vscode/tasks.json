{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "shell",
      "command": "node esbuild.mjs --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching\\.\\.\\.",
          "endsPattern": "Watching\\.\\.\\."
        }
      }
    }
  ]
}
