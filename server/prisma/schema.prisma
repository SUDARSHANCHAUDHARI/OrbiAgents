generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  savedWorkflows SavedWorkflow[]
  sessions       StoredSession[]
  createdAt      DateTime        @default(now())
}

model SavedWorkflow {
  id        String   @id @default(cuid())
  name      String
  data      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoredSession {
  id        String   @id @default(cuid())
  task      String
  frames    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
