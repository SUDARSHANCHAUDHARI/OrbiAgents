APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
DEFAULT_PROVIDER=anthropic
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WORKFLOW_MAX=12
MAX_RUNS_PER_HOUR=30
MAX_DAILY_COST_USD=10
MAX_WORKFLOW_NODES=12
MAX_PARALLEL_AGENTS=3

# Enable only when OrbiAgents is directly behind one trusted reverse proxy.
TRUST_PROXY=false

# Local coding agents are opt-in and only supported by POST /workflow.
# Both paths must be absolute. Worktrees are created below LOCAL_CLI_WORKTREE_ROOT.
LOCAL_CLI_ENABLED=false
# LOCAL_CLI_REPO_PATH=/absolute/path/to/repository
# LOCAL_CLI_WORKTREE_ROOT=/absolute/path/to/orbi-worktrees

# Add provider keys as needed
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: use OpenAI embeddings for memory retrieval. Local ranking remains the default and fallback.
MEMORY_EMBEDDINGS_ENABLED=false
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_CACHE_TTL_DAYS=30
# MEMORY_EMBEDDING_CACHE_MAX_ENTRIES=1000
